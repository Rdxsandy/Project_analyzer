# ─── Maven build output ───────────────────────────────────────────
target/
!.mvn/wrapper/maven-wrapper.jar
!**/src/main/**/target/
!**/src/test/**/target/

# ─── Node / frontend ──────────────────────────────────────────────
frontend/node_modules/
frontend/dist/
frontend/.vite/
frontend/.env.local
frontend/.env.*.local

# ─── IDEs ─────────────────────────────────────────────────────────
.idea/
*.iml
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ─── OS noise ─────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ─── Spring Boot secrets (never commit tokens!) ───────────────────
**/application-local.properties
**/application-secret.properties

# ─── Logs ─────────────────────────────────────────────────────────
*.log
logs/

# ─── Temp upload workspace ────────────────────────────────────────
/tmp/codeguardian-uploads/
